# 운영(서버) 환경변수. deploy/.env로 복사해 채운다. deploy/.env는 커밋하지 않는다.
# 앱 변수의 뜻은 루트의 .env.example과 docs/deploy.md에 있다.

# --- 도메인·HTTPS(Caddy) ---
MAGUS_DOMAIN=magus.example.com

# --- 앱(원격 모드) ---
PUBLIC_URL=https://magus.example.com
AUTH_ISSUER=https://<이름>.authkit.app
ALLOWED_USERS=user_01XXXX=default,user_01YYYY=father
SESSION_SECRET=<python -c "import secrets;print(secrets.token_hex(32))">
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
EMBEDDINGS=none
# MAX_UPLOAD_MB=50
# MAX_USER_MB=1000
# MAX_REQUEST_MB=2

# --- 알림(둘 중 하나) ---
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# --- 백업(restic → Cloudflare R2) ---
RESTIC_REPOSITORY=s3:https://<계정id>.r2.cloudflarestorage.com/magus-backup
RESTIC_PASSWORD=<잃어버리면 백업을 읽을 수 없다. 비밀번호 관리자에 따로 보관>
AWS_ACCESS_KEY_ID=<R2 API 토큰의 Access Key ID>
AWS_SECRET_ACCESS_KEY=<R2 API 토큰의 Secret>
AWS_DEFAULT_REGION=auto
HEALTHCHECK_URL=https://hc-ping.com/<uuid>
