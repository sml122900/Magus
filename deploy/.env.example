# 운영(서버) 환경변수. deploy/.env로 복사해 채운다. deploy/.env는 커밋하지 않는다.
# 앱 변수의 뜻은 루트의 .env.example과 docs/deploy.md에 있다.
# 값에 $가 있으면 작은따옴표로 감싼다(예: RESTIC_PASSWORD='ab$cd'). 감싸지 않으면 compose가 $ 뒤를 변수로 바꿔 값이 잘린다.

# --- 도메인·HTTPS(Caddy) ---
MAGUS_DOMAIN=magus.lifebookapplication.com

# --- 앱(원격 모드) ---
PUBLIC_URL=https://magus.lifebookapplication.com
# issuer는 /.well-known/openid-configuration의 issuer와 글자 그대로 같아야 한다(끝의 / 포함 여부까지)
AUTH_ISSUER=https://<이름>.authkit.app
# 처음에는 비워 둔다(모두 403). 첫 로그인 403 화면의 id를 넣는다: 본인 user_…=default, 나중에 ,user_…=father (docs/deploy.md 2-1)
ALLOWED_USERS=
SESSION_SECRET=<python -c "import secrets;print(secrets.token_hex(32))">
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
EMBEDDINGS=none
# MAX_UPLOAD_MB=50
# MAX_USER_MB=1000
# MAX_REQUEST_MB=2

# --- 알림(둘 중 하나) ---
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=

# --- healthchecks.io ---
# magus-alive(주기 5분, 유예 5분): deploy/alive.sh(호스트 cron)가 핑한다
HEALTHCHECK_ALIVE_URL=https://hc-ping.com/<uuid>
# magus-backup(주기 1일, 유예 2시간): deploy/backup.sh가 핑한다
HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# --- 백업(restic → Cloudflare R2) ---
R2_BUCKET=magus-backup
# R2 API 토큰 결과 화면의 S3 엔드포인트(버킷 이름 없이)
R2_ENDPOINT=https://<계정id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<R2 API 토큰의 Access Key ID>
R2_SECRET_ACCESS_KEY=<R2 API 토큰의 Secret Access Key>
RESTIC_PASSWORD=<잃어버리면 백업을 읽을 수 없다. 비밀번호 관리자에 따로 보관>
# 아래는 위 값으로 만든다(compose가 env 파일 안의 ${…}를 푼다). 고치지 않는다
RESTIC_REPOSITORY=s3:${R2_ENDPOINT}/${R2_BUCKET}
AWS_ACCESS_KEY_ID=${R2_ACCESS_KEY_ID}
AWS_SECRET_ACCESS_KEY=${R2_SECRET_ACCESS_KEY}
AWS_DEFAULT_REGION=auto

# 글의 첨부(#97): 한 개 한도(MB, 기본 20). 사용자 전체는 MAX_USER_MB(기본 1000)에 함께 든다
# MAX_ATTACH_MB=20

# 웹 도움말(#97): 오른쪽 아래 '?'. 키가 없으면 도움말만 '지금은 쓸 수 없어요'(다른 기능은 그대로).
# 키는 서버에서만 쓰고 브라우저로 내려보내지 않는다. 로그에는 호출 수·토큰 수·응답 시간·오류 코드만.
ANTHROPIC_API_KEY=
# HELP_DAILY_LIMIT=30            # 사용자별 하루 질문 수
# HELP_MODEL=claude-haiku-4-5-20251001
# HELP_MAX_TOKENS=600
