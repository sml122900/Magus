{
  "permissions": {
    "deny": ["Read(./deploy/.env)", "Read(./**/.env)", "Read(./**/.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/env_guard.py\" || exit 2" }
        ]
      }
    ]
  }
}
