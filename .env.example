# Magus 환경변수 예시. 이 파일을 .env로 복사해 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 비밀(키·시크릿)은 환경변수로만 넣는다. 코드나 저장소에 두지 않는다.

# --- 공통 ---
DATA_DIR=./data                 # 원본 파일과 index.sqlite
# FILES_DIR=                    # 로컬 모드에서 도구 경로 인자의 기준(기본: DATA_DIR의 부모)
EMBEDDINGS=none                 # none | voyage | openai
# VOYAGE_API_KEY=
# OPENAI_API_KEY=
# EMBEDDINGS_MODEL=

# --- 로컬 모드(stdio, Claude Desktop) ---
USER_ID=default                 # 로컬 모드의 사용자. 원격 모드에서는 쓰지 않는다(토큰의 sub로 정한다)

# --- 원격 모드(streamable-http, P1) ---
# PORT=8000                     # magus serve --transport http --host 0.0.0.0 --port $PORT
# PUBLIC_URL=https://magus.example.com          # 바깥에서 보이는 주소. 커넥터 URL = PUBLIC_URL/mcp
# AUTH_ISSUER=https://<이름>.authkit.app        # 인증 서버(WorkOS AuthKit) issuer
# AUTH_JWKS_URL=                                # 비우면 issuer 메타데이터에서 찾는다(WorkOS: <issuer>/oauth2/jwks)
# AUTH_AUDIENCE=                                # 비워 둔다(= PUBLIC_URL/mcp). 다른 값이면 서버가 시작하지 않는다(결정 #79)
# ALLOWED_USERS=user_01XXXX=default,user_01YYYY=father   # sub=user_id. 여기 없는 사용자는 403. 비우면 모두 403(첫 로그인으로 id 얻기)
# SESSION_SECRET=                               # 원격 필수: 32자 이상 무작위(예: python -c "import secrets;print(secrets.token_hex(32))")
# WEB_CLIENT_ID=                                # 웹 로그인용 OAuth 클라이언트(WorkOS에 등록, 콜백 PUBLIC_URL/auth/callback)
# WEB_CLIENT_SECRET=                            # 공개 클라이언트(PKCE)면 비운다

# --- 한도 ---
# MAX_UPLOAD_MB=50                              # 업로드 한 개
# MAX_USER_MB=1000                              # 사용자 폴더 전체
# MAX_REQUEST_MB=2                              # MCP 요청 본문(넘으면 413)
